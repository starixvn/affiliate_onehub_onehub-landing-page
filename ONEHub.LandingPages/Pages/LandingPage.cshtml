</div>

<div class="straight-lock-in" aria-live="polite">
    <div class="icon icon-mobile img-rotate" aria-hidden="true">
        <i class="icon icon-spinner11"></i>
    </div>
    <div class="text">
        @UI.Mobile_DearCustomer
        <br />@UI.Mobile_BetterExperience<br />
        <span class="text-org">@UI.Mobile_RotatePhone</span>
        <br />@UI.Mobile_Apologize
    </div>
