@page "/p1/{languageCode}/{PageCode}"
@using ONEHub.LandingPages.Core
@using ONEHub.LandingPages.Core.Models
@model ONEHub.LandingPages.Pages.LandingPageModel

@{
    ViewData["Title"] = UI.PageTitle_LandingPage;
    Layout = "Shared/_Layout.cshtml";
}

@if (Model?.LandingPage?.Modules?.Any() == true)
{
    IEnumerable<IGrouping<int, LandingPageModule>> components = Model?.LandingPage?.Modules.GroupBy(testc => testc.OrderId)!;

    foreach (var module in components)
    {
        var moduleName = Enum.GetName(typeof(UiModule), module.FirstOrDefault()!.ModuleId);
        if (!string.IsNullOrWhiteSpace(moduleName))
        {
            Model!.LandingPage.CurrentModules = module;
            @await Component.InvokeAsync(moduleName, Model)
        }
    }
}

